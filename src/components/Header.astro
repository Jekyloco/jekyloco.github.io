---
import { existsSync, readdirSync } from 'node:fs';
import { basename, extname, join } from 'node:path';
import { SITE_TITLE } from '../consts';
import LogoImage from '../images/logo.jpg';
import { SITE_CONFIG } from '../site.config';
import HeaderLink from './HeaderLink.astro';

const musicConfig = SITE_CONFIG.music;
const musicRandom = musicConfig.random === true;
const musicAutoplay = musicConfig.autoplay === true;
const musicShowOnLoad = musicConfig.showOnLoad !== false;
const musicLoop = musicConfig.loop !== false;
const musicPreload = musicConfig.preload ?? 'auto';
const musicLrc = musicConfig.lrc ?? '';
const musicLrcEncoding = musicConfig.lrcEncoding ?? 'utf-8';
const musicLang = musicConfig.lang ?? 'ja';
const mediaDir = join(process.cwd(), 'public', 'media');
const mediaFiles = existsSync(mediaDir) ? readdirSync(mediaDir) : [];
const lrcFiles = new Map(
	mediaFiles
		.filter((file) => extname(file).toLowerCase() === '.lrc')
		.map((file) => [basename(file, extname(file)).toLowerCase(), file]),
);
const mediaPath = (file: string) => `/media/${encodeURIComponent(file)}`;
const scannedPlaylist = mediaFiles
	.filter((file) => extname(file).toLowerCase() === '.flac')
	.sort((a, b) => a.localeCompare(b))
	.map((file) => {
		const name = basename(file, extname(file));
		const lrcFile = lrcFiles.get(name.toLowerCase());
		return {
			title: name,
			src: mediaPath(file),
			lrc: lrcFile ? mediaPath(lrcFile) : '',
		};
	});
const fallbackTrack = {
	title: 'Music',
	src: musicConfig.src,
	lrc: musicLrc,
};
const musicPlaylist = musicRandom && scannedPlaylist.length ? scannedPlaylist : [fallbackTrack];
const initialTrack = musicPlaylist[0] ?? fallbackTrack;
const audioLoop = musicRandom && musicPlaylist.length > 1 ? false : musicLoop;
---

<header class="site-header">
	<div class="container header-inner">
		<div class="header-left">
			<a class="brand" href="/" aria-label={SITE_TITLE}>
				<img class="brand-logo" src={LogoImage.src} width="34" height="34" alt={SITE_TITLE} loading="eager" />
				<span class="brand-text">{SITE_TITLE}</span>
			</a>
			<nav class="nav-links" id="primary-nav" aria-label="Primary">
				<HeaderLink href="/blog">Posts</HeaderLink>
				<HeaderLink href="/docs">Docs</HeaderLink>
				<HeaderLink href="/projects">Projects</HeaderLink>
				<HeaderLink href="/links">Links</HeaderLink>
				<HeaderLink href="/about">About</HeaderLink>
			</nav>
		</div>
		<div class="actions">
			<button
				class="btn-icon nav-toggle"
				id="nav-toggle"
				type="button"
				aria-label="Open navigation menu"
				aria-controls="primary-nav"
				aria-expanded="false"
			>
				<svg class="icon-menu" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
					<path
						fill="currentColor"
						d="M4 7a1 1 0 011-1h14a1 1 0 110 2H5a1 1 0 01-1-1zm0 5a1 1 0 011-1h14a1 1 0 110 2H5a1 1 0 01-1-1zm0 5a1 1 0 011-1h14a1 1 0 110 2H5a1 1 0 01-1-1z"
					/>
				</svg>
				<svg class="icon-close" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
					<path
						fill="currentColor"
						d="M6.3 5.3a1 1 0 011.4 0L12 9.59l4.3-4.3a1 1 0 111.4 1.42L13.41 11l4.3 4.3a1 1 0 01-1.42 1.4L12 12.41l-4.3 4.3a1 1 0 01-1.4-1.42L10.59 11l-4.3-4.3a1 1 0 010-1.4z"
					/>
				</svg>
			</button>
			<button
				class="btn-icon"
				id="music-toggle"
				type="button"
				aria-label={musicAutoplay ? 'Pause background music' : 'Play background music'}
				aria-pressed={String(musicAutoplay)}
				data-playing={String(musicAutoplay)}
			>
				<svg class="icon-music-on" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
					<path
						fill="currentColor"
						d="M12 4a1 1 0 011-1h6a1 1 0 011 1v3a1 1 0 01-.76.97L14 9.28V17a4 4 0 11-2-3.46V4zm2 3.22l4-1V5h-4v2.22zM10 17a2 2 0 10-2 2 2 2 0 002-2z"
					/>
				</svg>
				<svg class="icon-music-off" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
					<path
						fill="currentColor"
						d="M4.71 3.29a1 1 0 00-1.42 1.42l8.55 8.55A4 4 0 1013 16.07v-.81l6.29 6.29a1 1 0 001.42-1.42l-16-16zM8 19a2 2 0 111.84-2.78l1.5 1.5A2 2 0 018 19zm5-15a1 1 0 011-1h5a1 1 0 011 1v3a1 1 0 01-.76.97L14 9.28v1.21l-2-2V4a1 1 0 011-1z"
					/>
				</svg>
			</button>
			<a class="btn-icon" href="/search" aria-label="Search">
				<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
					<path
						fill="currentColor"
						d="M10 4a6 6 0 104.472 10.02l4.254 4.254a1 1 0 001.414-1.414l-4.254-4.254A6 6 0 0010 4zm-4 6a4 4 0 118 0 4 4 0 01-8 0z"
					/>
				</svg>
			</a>
			<button class="btn-icon" id="theme-toggle" type="button" aria-label="Toggle theme">
				<svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
					<path
						fill="currentColor"
						d="M21 14.77A8 8 0 1111.23 3a6.5 6.5 0 109.77 11.77z"
					/>
				</svg>
				<svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
					<path
						fill="currentColor"
						d="M12 18a6 6 0 110-12 6 6 0 010 12zm0-16a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm0 18a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zm10-9a1 1 0 01-1 1h-1a1 1 0 110-2h1a1 1 0 011 1zM4 12a1 1 0 01-1 1H2a1 1 0 110-2h1a1 1 0 011 1zm15.07-7.07a1 1 0 010 1.41l-.7.7a1 1 0 11-1.42-1.41l.71-.7a1 1 0 011.41 0zM7.05 17.66a1 1 0 010 1.41l-.7.71a1 1 0 01-1.42-1.42l.71-.7a1 1 0 011.41 0zm12.02 1.41a1 1 0 01-1.41 0l-.71-.7a1 1 0 011.42-1.42l.7.71a1 1 0 010 1.41zM6.34 7.05a1 1 0 01-1.41 0l-.71-.7A1 1 0 015.64 4.93l.7.71a1 1 0 010 1.41z"
					/>
				</svg>
			</button>
		</div>
	</div>
	<audio
		id="background-music"
		src={initialTrack.src}
		preload={musicPreload}
		loop={audioLoop}
		autoplay={musicAutoplay}
		transition:persist
	></audio>
</header>

<aside class="music-player" aria-label="Background music player" lang={musicLang}>
	<div class="music-player-inner">
		<button
			class="music-player-button"
			id="music-player-toggle"
			type="button"
			aria-label={musicAutoplay ? 'Pause background music' : 'Play background music'}
			aria-pressed={String(musicAutoplay)}
			data-playing={String(musicAutoplay)}
		>
			<svg class="icon-music-on" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
				<path fill="currentColor" d="M8 5.8a1 1 0 011.55-.83l8 5.2a1 1 0 010 1.66l-8 5.2A1 1 0 018 16.2V5.8z" />
			</svg>
			<svg class="icon-music-off" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
				<path fill="currentColor" d="M7 5a1 1 0 011-1h1a1 1 0 011 1v14a1 1 0 01-1 1H8a1 1 0 01-1-1V5zm7 0a1 1 0 011-1h1a1 1 0 011 1v14a1 1 0 01-1 1h-1a1 1 0 01-1-1V5z" />
			</svg>
		</button>
		<div class="music-player-main-wrap">
			<div class="music-player-main">
				<div class="music-player-meta">
					<div class="music-player-title" id="music-title">Music</div>
					<div class="music-player-artist" id="music-artist">Artist</div>
				</div>
				<p class="music-player-lyric" id="music-lyric">Loading lyrics...</p>
				<div class="music-player-progress">
					<span id="music-current-time">0:00</span>
					<input id="music-progress" type="range" min="0" max="1000" value="0" step="1" aria-label="Music progress" />
					<span id="music-duration">0:00</span>
				</div>
			</div>
			<button
				class="music-player-hide"
				id="music-player-hide"
				type="button"
				aria-label="Hide music player"
				title="Hide player"
			>
				<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
					<path
						fill="currentColor"
						d="M12 16a1 1 0 01-.7-.29l-6-6a1 1 0 111.4-1.42L12 13.59l5.3-5.3a1 1 0 111.4 1.42l-6 6A1 1 0 0112 16z"
					/>
				</svg>
			</button>
		</div>
	</div>
</aside>
<button class="music-player-show" id="music-player-show" type="button" aria-label="Show music player" hidden>
	Open player
</button>

<script is:inline data-astro-rerun define:vars={{ musicAutoplay, musicLrcEncoding, musicLang, musicPlaylist, musicRandom, musicShowOnLoad }}>
	(() => {
		const header = document.querySelector('.site-header');
		const button = document.getElementById('nav-toggle');
		const nav = document.getElementById('primary-nav');
		if (!(header instanceof HTMLElement) || !(button instanceof HTMLButtonElement) || !(nav instanceof HTMLElement)) return;

		const setOpen = (open) => {
			header.dataset.navOpen = String(open);
			button.setAttribute('aria-expanded', String(open));
			button.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
		};

		button.addEventListener('click', () => {
			setOpen(header.dataset.navOpen !== 'true');
		});
		nav.addEventListener('click', (event) => {
			if (event.target instanceof HTMLAnchorElement) setOpen(false);
		});
		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') setOpen(false);
		});
		document.addEventListener('click', (event) => {
			if (!header.contains(event.target)) setOpen(false);
		});
	})();

	(() => {
		const button = document.getElementById('theme-toggle');
		if (!button) return;
		button.addEventListener('click', () => {
			const current = document.documentElement.dataset.theme;
			const next = current === 'dark' ? 'light' : 'dark';
			document.documentElement.dataset.theme = next;
			localStorage.setItem('theme', next);
		});
	})();

	(() => {
		if (window.__musicPlayerCleanup) window.__musicPlayerCleanup();

		const cleanups = [];
		const on = (target, event, handler, options) => {
			target.addEventListener(event, handler, options);
			cleanups.push(() => target.removeEventListener(event, handler, options));
		};

		const buttons = [document.getElementById('music-toggle'), document.getElementById('music-player-toggle')].filter(
			(button) => button instanceof HTMLButtonElement,
		);
		const audio = document.getElementById('background-music');
		const title = document.getElementById('music-title');
		const artist = document.getElementById('music-artist');
		const lyric = document.getElementById('music-lyric');
		const progress = document.getElementById('music-progress');
		const currentTime = document.getElementById('music-current-time');
		const duration = document.getElementById('music-duration');
		const player = document.querySelector('.music-player');
		const hidePlayerButton = document.getElementById('music-player-hide');
		const showPlayerButton = document.getElementById('music-player-show');
		if (!(audio instanceof HTMLAudioElement)) return;
		if (!(player instanceof HTMLElement)) return;
		if (lyric) lyric.setAttribute('lang', musicLang);
		if (title) title.setAttribute('lang', musicLang);
		if (artist) artist.setAttribute('lang', musicLang);

		let manuallyPaused = !musicAutoplay;
		let seeking = false;
		let lyrics = [];
		let lyricRequestId = 0;
		let activeTrack = null;
		const hiddenKey = 'music-player-hidden';
		const savedPlayerHidden = localStorage.getItem(hiddenKey);
		let isPlayerHidden = savedPlayerHidden === null ? !musicShowOnLoad : savedPlayerHidden === '1';
		const playlist = Array.isArray(musicPlaylist) ? musicPlaylist.filter((track) => track?.src) : [];
		window.__musicPlayerCleanup = () => {
			for (const cleanup of cleanups) cleanup();
		};

		const syncPlayerVisibility = () => {
			player.dataset.hidden = String(isPlayerHidden);
			<!-- document.body.classList.toggle('music-player-collapsed', isPlayerHidden); -->
			if (showPlayerButton instanceof HTMLButtonElement) showPlayerButton.hidden = !isPlayerHidden;
		};

		const setPlayerHidden = (nextHidden) => {
			isPlayerHidden = Boolean(nextHidden);
			localStorage.setItem(hiddenKey, isPlayerHidden ? '1' : '0');
			syncPlayerVisibility();
		};

		const getTrackName = (track) => {
			if (track?.title) return track.title;
			const fileName = decodeURIComponent((track?.src ?? '').split('/').pop() ?? '');
			return fileName.replace(/\.[^.]+$/, '') || 'Music';
		};

		const normalizePath = (src) => {
			try {
				return new URL(src, window.location.href).pathname;
			} catch {
				return src;
			}
		};

		const getCurrentTrack = () => {
			const currentPath = normalizePath(audio.currentSrc || audio.getAttribute('src') || '');
			return playlist.find((track) => normalizePath(track.src) === currentPath) ?? null;
		};

		const pickRandomTrack = () => {
			if (playlist.length <= 1) return playlist[0] ?? null;
			const candidates = playlist.filter((track) => track.src !== activeTrack?.src);
			return candidates[Math.floor(Math.random() * candidates.length)] ?? playlist[0];
		};

		const setTrack = (track) => {
			if (!track) return;
			activeTrack = track;
			lyrics = [];
			lyricRequestId += 1;
			if (title) title.textContent = getTrackName(track);
			if (artist) artist.textContent = 'Artist';
			if (lyric) lyric.textContent = track.lrc ? 'Loading lyrics...' : 'No synced lyrics';
			if (progress instanceof HTMLInputElement) progress.value = '0';
			if (currentTime) currentTime.textContent = '0:00';
			if (duration) duration.textContent = '0:00';
			if (audio.getAttribute('src') !== track.src) {
				audio.src = track.src;
				audio.load();
			}
			loadLyrics(track);
		};

		const syncButton = () => {
			const isPlaying = !audio.paused && !audio.ended;
			for (const button of buttons) {
				button.dataset.playing = String(isPlaying);
				button.setAttribute('aria-pressed', String(isPlaying));
				button.setAttribute('aria-label', isPlaying ? 'Pause background music' : 'Play background music');
			}
		};

		const playAudio = async () => {
			try {
				await audio.play();
			} catch {
				// Browsers can block audible autoplay until the first user gesture.
			}
			syncButton();
		};

		const toggleAudio = () => {
			if (audio.paused) {
				manuallyPaused = false;
				playAudio();
				return;
			}
			manuallyPaused = true;
			audio.pause();
			syncButton();
		};

		const formatTime = (seconds) => {
			if (!Number.isFinite(seconds)) return '0:00';
			const minutes = Math.floor(seconds / 60);
			const rest = Math.floor(seconds % 60).toString().padStart(2, '0');
			return `${minutes}:${rest}`;
		};

		const parseLrc = (text) => {
			const meta = {};
			const parsedLyrics = [];
			for (const line of text.split(/\r?\n/)) {
				const metaMatch = line.match(/^\[(ti|ar|al|by|offset):([^\]]*)\]$/i);
				if (metaMatch) {
					meta[metaMatch[1].toLowerCase()] = metaMatch[2].trim();
					continue;
				}

				const lyricText = line.replace(/(?:\[\d{2}:\d{2}(?:\.\d{1,3})?\])+/g, '').trim();
				const timeMatches = [...line.matchAll(/\[(\d{2}):(\d{2})(?:\.(\d{1,3}))?\]/g)];
				for (const match of timeMatches) {
					const fraction = (match[3] ?? '0').padEnd(3, '0').slice(0, 3);
					parsedLyrics.push({
						time: Number(match[1]) * 60 + Number(match[2]) + Number(fraction) / 1000,
						text: lyricText,
					});
				}
			}
			parsedLyrics.sort((a, b) => a.time - b.time);
			return { meta, lyrics: parsedLyrics.filter((item) => item.text) };
		};

		const decodeLrc = (buffer) => {
			const encodings = [musicLrcEncoding, 'utf-8', 'gb18030', 'shift_jis'].filter(
				(encoding, index, list) => encoding && list.indexOf(encoding) === index,
			);
			for (const encoding of encodings) {
				try {
					return new TextDecoder(encoding, { fatal: true }).decode(buffer);
				} catch {
					// Try the next likely lyrics encoding.
				}
			}
			return new TextDecoder().decode(buffer);
		};

		const updateLyric = () => {
			if (!lyric || lyrics.length === 0) return;
			let active = lyrics[0];
			for (const item of lyrics) {
				if (item.time > audio.currentTime) break;
				active = item;
			}
			lyric.textContent = active?.text ?? '';
		};

		const updateProgress = () => {
			if (currentTime) currentTime.textContent = formatTime(audio.currentTime);
			if (duration) duration.textContent = formatTime(audio.duration);
			if (!seeking && progress instanceof HTMLInputElement) {
				const value = audio.duration ? (audio.currentTime / audio.duration) * 1000 : 0;
				progress.value = String(Math.max(0, Math.min(1000, value)));
			}
			updateLyric();
		};

		const loadLyrics = async (track) => {
			const requestId = lyricRequestId;
			if (!track?.lrc || !lyric) return;
			try {
				const response = await fetch(track.lrc);
				if (!response.ok) throw new Error(`Failed to load ${track.lrc}`);
				const parsed = parseLrc(decodeLrc(await response.arrayBuffer()));
				if (requestId !== lyricRequestId) return;
				lyrics = parsed.lyrics;
				if (title && parsed.meta.ti) title.textContent = parsed.meta.ti;
				if (artist && parsed.meta.ar) artist.textContent = parsed.meta.ar;
				lyric.textContent = lyrics[0]?.text ?? 'No synced lyrics';
			} catch {
				if (requestId !== lyricRequestId) return;
				lyric.textContent = 'Lyrics unavailable';
			}
		};

		for (const button of buttons) {
			on(button, 'click', toggleAudio);
		}
		if (hidePlayerButton instanceof HTMLButtonElement) {
			on(hidePlayerButton, 'click', () => setPlayerHidden(true));
		}
		if (showPlayerButton instanceof HTMLButtonElement) {
			on(showPlayerButton, 'click', () => setPlayerHidden(false));
		}

		if (progress instanceof HTMLInputElement) {
			on(progress, 'input', () => {
				seeking = true;
				if (currentTime) {
					const nextTime = audio.duration ? (Number(progress.value) / 1000) * audio.duration : 0;
					currentTime.textContent = formatTime(nextTime);
				}
			});
			on(progress, 'change', () => {
				if (audio.duration) audio.currentTime = (Number(progress.value) / 1000) * audio.duration;
				seeking = false;
				updateProgress();
			});
		}

		on(audio, 'play', syncButton);
		on(audio, 'pause', syncButton);
		on(audio, 'loadedmetadata', updateProgress);
		on(audio, 'timeupdate', updateProgress);
		on(audio, 'ended', () => {
			if (!musicRandom || playlist.length <= 1) return;
			setTrack(pickRandomTrack());
			if (!manuallyPaused) playAudio();
		});

		const retryAutoplay = () => {
			if (!manuallyPaused && audio.paused) playAudio();
			document.removeEventListener('pointerdown', retryAutoplay);
			document.removeEventListener('keydown', retryAutoplay);
		};

		on(document, 'pointerdown', retryAutoplay, { once: true });
		on(document, 'keydown', retryAutoplay, { once: true });

		const persistedTrack = getCurrentTrack();
		const hasPersistedAudio = Boolean(persistedTrack && (audio.currentTime > 0 || !audio.paused || audio.readyState > 0));
		setTrack(hasPersistedAudio ? persistedTrack : musicRandom ? pickRandomTrack() : playlist[0]);
		updateProgress();
		if (musicAutoplay) playAudio();
		else syncButton();
		syncPlayerVisibility();
	})();
</script>
<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 20;
		background: rgba(var(--bg), 0.6);
		backdrop-filter: saturate(180%) blur(14px);
		border-bottom: 1px solid rgb(var(--border));
	}
	.header-inner {
		display: grid;
		grid-template-columns: 1fr auto;
		align-items: center;
		gap: 0.75rem;
		height: 64px;
	}
	.header-left {
		display: flex;
		align-items: center;
		flex-wrap: nowrap;
		gap: 0.5rem;
		min-width: 0;
		overflow: hidden;
		height: 100%;
		align-self: stretch;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		font-weight: 700;
		font-size: 1.25rem;
		letter-spacing: -0.02em;
		text-decoration: none;
		color: rgb(var(--black));
		white-space: nowrap;
		height: 100%;
		padding: 0 0.6rem;
		border-radius: 12px;
		border: 1px solid transparent;
		transition: background 120ms ease, color 120ms ease, border-color 120ms ease, box-shadow 120ms ease;
	}
	.brand:hover {
		background: rgba(var(--accent-rgb), 0.12);
		color: rgb(var(--black));
		border-color: rgba(var(--border), 0.75);
		box-shadow: var(--shadow);
	}
	.brand-logo {
		width: 34px;
		height: 34px;
		border-radius: 10px;
		border: 1px solid rgb(var(--border));
		background: rgba(var(--card), var(--card-alpha, 0.84));
		box-shadow: var(--shadow);
		object-fit: cover;
	}
	.brand-text {
		line-height: 1;
	}
	.nav-links {
		display: flex;
		flex-wrap: nowrap;
		gap: 0.25rem;
		align-items: stretch;
		overflow-x: auto;
		overflow-y: hidden;
		white-space: nowrap;
		min-width: 0;
		height: 100%;
		scrollbar-width: none;
		-ms-overflow-style: none;
	}
	.nav-links::-webkit-scrollbar {
		display: none;
	}
	.nav-links :global(a) {
		display: inline-flex;
		align-items: center;
		height: 100%;
		padding: 0 0.75rem;
		border-radius: 10px;
		border: 1px solid transparent;
		color: rgb(var(--gray-dark));
		text-decoration: none;
		font-size: 1rem;
