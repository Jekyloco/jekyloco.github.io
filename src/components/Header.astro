---
import { SITE_TITLE } from '../consts';
import LogoImage from '../images/logo.jpg';
import HeaderLink from './HeaderLink.astro';
---

<header class="site-header">
	<div class="container header-inner">
		<a class="brand" href="/" aria-label={SITE_TITLE}>
			<img class="brand-logo" src={LogoImage.src} width="34" height="34" alt={SITE_TITLE} loading="eager" />
			<span class="brand-text">{SITE_TITLE}</span>
		</a>
		<nav class="nav-links" aria-label="Primary">
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/docs">Docs</HeaderLink>
			<HeaderLink href="/projects">Projects</HeaderLink>
			<HeaderLink href="/links">Links</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</nav>
		<div class="actions">
			<a class="btn-icon" href="/search" aria-label="Search">
				<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
					<path
						fill="currentColor"
						d="M10 4a6 6 0 104.472 10.02l4.254 4.254a1 1 0 001.414-1.414l-4.254-4.254A6 6 0 0010 4zm-4 6a4 4 0 118 0 4 4 0 01-8 0z"
					/>
				</svg>
			</a>
			<button class="btn-icon" id="theme-toggle" type="button" aria-label="Toggle theme">
				<svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
					<path
						fill="currentColor"
						d="M21 14.77A8 8 0 1111.23 3a6.5 6.5 0 109.77 11.77z"
					/>
				</svg>
				<svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
					<path
						fill="currentColor"
						d="M12 18a6 6 0 110-12 6 6 0 010 12zm0-16a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm0 18a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zm10-9a1 1 0 01-1 1h-1a1 1 0 110-2h1a1 1 0 011 1zM4 12a1 1 0 01-1 1H2a1 1 0 110-2h1a1 1 0 011 1zm15.07-7.07a1 1 0 010 1.41l-.7.7a1 1 0 11-1.42-1.41l.71-.7a1 1 0 011.41 0zM7.05 17.66a1 1 0 010 1.41l-.7.71a1 1 0 01-1.42-1.42l.71-.7a1 1 0 011.41 0zm12.02 1.41a1 1 0 01-1.41 0l-.71-.7a1 1 0 011.42-1.42l.7.71a1 1 0 010 1.41zM6.34 7.05a1 1 0 01-1.41 0l-.71-.7A1 1 0 015.64 4.93l.7.71a1 1 0 010 1.41z"
					/>
				</svg>
			</button>
		</div>
	</div>
</header>

<script is:inline>
	(() => {
		const button = document.getElementById('theme-toggle');
		if (!button) return;
		button.addEventListener('click', () => {
			const current = document.documentElement.dataset.theme;
			const next = current === 'dark' ? 'light' : 'dark';
			document.documentElement.dataset.theme = next;
			localStorage.setItem('theme', next);
		});
	})();
</script>
<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 20;
		background: rgba(var(--bg), 0.6);
		backdrop-filter: saturate(180%) blur(14px);
		border-bottom: 1px solid rgb(var(--border));
	}
	.header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		height: 64px;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		font-weight: 700;
		font-size: 1.25rem;
		letter-spacing: -0.02em;
		text-decoration: none;
		color: rgb(var(--black));
		white-space: nowrap;
	}
	.brand-logo {
		width: 34px;
		height: 34px;
		border-radius: 10px;
		border: 1px solid rgb(var(--border));
		background: rgba(var(--card), var(--card-alpha, 0.84));
		box-shadow: var(--shadow);
		object-fit: cover;
	}
	.brand-text {
		line-height: 1;
	}
	.nav-links {
		display: flex;
		gap: 0.25rem;
		align-items: center;
		overflow-x: auto;
	}
	.nav-links :global(a) {
		padding: 0.5rem 0.75rem;
		border-radius: 10px;
		color: rgb(var(--gray-dark));
		text-decoration: none;
		font-size: 1rem;
	}
	.nav-links :global(a.active) {
		color: rgb(var(--black));
		background: rgba(var(--gray-light), 0.35);
		border: 1px solid rgb(var(--border));
	}
	.actions {
		display: flex;
		gap: 0.5rem;
		align-items: center;
	}
	#theme-toggle {
		position: relative;
	}
	.icon-sun {
		display: none;
	}
	:global(html[data-theme='dark']) .icon-sun {
		display: block;
	}
	:global(html[data-theme='dark']) .icon-moon {
		display: none;
	}
	@media (max-width: 720px) {
		.nav-links {
			display: none;
		}
		.brand-text {
			display: none;
		}
	}
</style>
