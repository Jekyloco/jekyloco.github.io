---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../images/blog-placeholder-1.jpg';
import { SITE_TITLE } from '../consts';
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import { SITE_CONFIG } from '../site.config';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image = FallbackImage } = Astro.props;
const defaultTheme = SITE_CONFIG.theme.default === 'dark' ? 'dark' : 'light';

const cssVarName = (key: string) => {
	if (key === 'accentRgb') return '--accent-rgb';
	if (key === 'bgRgb') return '--bg';
	if (key === 'cardRgb') return '--card';
	if (key === 'borderRgb') return '--border';
	if (key === 'linkHover') return '--link-hover';
	return `--${key}`;
};

const themeLightCss = Object.entries(SITE_CONFIG.theme.light)
	.filter(([, v]) => v)
	.map(([k, v]) => {
		return `${cssVarName(k)}:${v};`;
	})
	.join('');

const themeDarkCss = Object.entries(SITE_CONFIG.theme.dark)
	.filter(([, v]) => v)
	.map(([k, v]) => {
		return `${cssVarName(k)}:${v};`;
	})
	.join('');

const markdownCss = Object.entries(SITE_CONFIG.markdown ?? {})
	.filter(([, v]) => v)
	.map(([k, v]) => {
		if (k === 'fontFamily') return `--prose-font-family:${v};`;
		if (k === 'fontSize') return `--prose-font-size:${v};`;
		if (k === 'lineHeight') return `--prose-line-height:${v};`;
		if (k === 'backgroundRgb') return `--prose-bg-rgb:${v};`;
		return '';
	})
	.filter(Boolean)
	.join('');

const injectedCss = [
	(markdownCss || themeLightCss) ? `:root{${markdownCss}${themeLightCss}}` : '',
	themeDarkCss ? `html[data-theme='dark']{${themeDarkCss}}` : '',
	SITE_CONFIG.backgroundImage ? `:root{--site-bg-image:url(${JSON.stringify(SITE_CONFIG.backgroundImage)})}` : '',
]
	.filter(Boolean)
	.join('\n');

const configuredIcons = [SITE_CONFIG.favicon.svg, SITE_CONFIG.favicon.ico].filter(Boolean);
const iconLinks = configuredIcons.length
	? configuredIcons.map((href) => ({
			href,
			type: href.endsWith('.svg') ? 'image/svg+xml' : undefined,
		}))
	: [
			{ href: '/favicon.svg', type: 'image/svg+xml' },
			{ href: '/favicon.ico', type: undefined },
		];
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<ClientRouter />
<script is:inline define:vars={{ defaultTheme }}>
	(() => {
		const getTheme = () => {
			const storedDefault = localStorage.getItem('theme-default');
			const stored = localStorage.getItem('theme');
			return storedDefault === defaultTheme && stored ? stored : defaultTheme;
		};

		const applyTheme = () => {
			const theme = getTheme();
			document.documentElement.dataset.theme = theme;
			localStorage.setItem('theme-default', defaultTheme);
			localStorage.setItem('theme', theme);
			return theme;
		};

		applyTheme();

		if (window.__themeSwapBound) return;
		window.__themeSwapBound = true;

		document.addEventListener('astro:before-swap', (event) => {
			const theme = localStorage.getItem('theme') ?? getTheme();
			event.newDocument.documentElement.dataset.theme = theme;
		});
		document.addEventListener('astro:after-swap', applyTheme);
	})();
</script>
<script is:inline>
	(() => {
		if (window.__pageStateTools) return;

		const createCleanupContext = (cleanupKey) => {
			const previousCleanup = window[cleanupKey];
			if (typeof previousCleanup === 'function') previousCleanup();

			const cleanups = [];
			const on = (target, event, handler, options) => {
				target.addEventListener(event, handler, options);
				cleanups.push(() => target.removeEventListener(event, handler, options));
			};
			const register = (extraCleanup) => {
				window[cleanupKey] = () => {
					for (const cleanup of cleanups) cleanup();
					if (typeof extraCleanup === 'function') extraCleanup();
				};
			};

			register();
			return { on, register };
		};

		const updateQueryParams = (nextParams, options = {}) => {
			const url = new URL(window.location.href);
			const clearKeys = Array.isArray(options.clearKeys) ? options.clearKeys : [];
			const removeKeys = Array.isArray(options.removeKeys) ? options.removeKeys : [];
			const resetPageKey = typeof options.resetPageKey === 'string' ? options.resetPageKey : '';
			const replace = options.replace === true;

			for (const key of clearKeys) url.searchParams.delete(key);
			for (const key of removeKeys) url.searchParams.delete(key);
			for (const [key, value] of Object.entries(nextParams ?? {})) {
				if (value === null || value === undefined || value === '') url.searchParams.delete(key);
				else url.searchParams.set(key, String(value));
			}
			if (resetPageKey) url.searchParams.delete(resetPageKey);
			window.history[replace ? 'replaceState' : 'pushState']({}, '', url);
		};

		const bindComposingInput = (context, input, onChange) => {
			if (!(input instanceof HTMLInputElement) || typeof onChange !== 'function') return;
			let composing = false;
			context.on(input, 'compositionstart', () => {
				composing = true;
			});
			context.on(input, 'compositionend', () => {
				composing = false;
				onChange(input.value.trim());
			});
			context.on(input, 'input', () => {
				if (composing) return;
				onChange(input.value.trim());
			});
		};

		window.__pageStateTools = {
			createCleanupContext,
			updateQueryParams,
			bindComposingInput,
		};
	})();
</script>
{injectedCss && <style set:html={injectedCss} />}
{
	iconLinks.map((icon) => (
		<link rel="icon" href={icon.href} type={icon.type} />
	))
}
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<Font cssVariable="--font-atkinson" preload />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image.src, Astro.url)} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image.src, Astro.url)} />
