---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { formatPostBodyCharCount } from '../utils/postBodyStats';

type Props = {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	heroImage?: CollectionEntry<'blog'>['data']['heroImage'];
	tags?: string[];
	lang?: string;
	bodyCharCount?: number;
	relatedPosts?: Array<{
		id: string;
		data: CollectionEntry<'blog'>['data'];
		listingDescription: string;
	}>;
};

const { title, description, pubDate, updatedDate, heroImage, tags = [], lang, bodyCharCount, relatedPosts = [] } =
	Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			.post {
				max-width: 1120px;
				margin: 0 auto;
			}
			.post-header {
				display: grid;
				grid-template-columns: 1fr minmax(220px, 360px);
				gap: 1.25rem;
				align-items: stretch;
				padding: 0.25rem 0 1rem;
			}
			.post-header-main {
				margin: 30px 0;
				min-width: 0;
				display: flex;
				flex-direction: column;
				justify-content: space-between;
				align-self: stretch;
			}
			.post-header-media {
				width: 100%;
				border-radius: 16px;
				border: 1px solid rgb(var(--border));
				box-shadow: var(--shadow);
				overflow: hidden;
				aspect-ratio: 16 / 10;
				background: rgba(var(--card), var(--card-alpha, 0.84));
			}
			.post-header-media img {
				display: block;
				width: 100%;
				height: 100%;
				object-fit: cover;
			}
			.post-title {
				margin: 0;
				letter-spacing: -0.02em;
			}
			.post-meta {
				display: flex;
				flex-wrap: wrap;
				gap: 0.6rem;
				align-items: center;
				color: rgb(var(--gray));
				font-size: 0.9rem;
			}
			.post-tags {
				margin-top: 0;
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
			}
			.post-content {
				border-radius: 16px;
				border: 1px solid rgb(var(--border));
				background: rgb(var(--prose-bg-rgb, var(--card)));
				padding: 3.35rem 3.35rem 3.1rem;
				box-shadow: none;
			}
			.prose {
				color: rgb(var(--gray-dark));
				font-size: var(--prose-font-size, 1.15rem);
				line-height: var(--prose-line-height, 1.95);
				font-family: var(--prose-font-family, var(--font-atkinson));
			}
			.related-posts {
				margin-top: 1rem;
			}
			.related-posts-title {
				margin: 0 0 0.7rem;
				font-size: 1.1rem;
				color: rgb(var(--black));
			}
			.related-posts-grid {
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: 0.75rem;
			}
			.related-post-card {
				display: grid;
				gap: 0.35rem;
				padding: 0.85rem 0.95rem;
				text-decoration: none;
			}
			.related-post-card-title {
				margin: 0;
				color: rgb(var(--black));
				font-size: 0.98rem;
				line-height: 1.3;
				font-weight: 700;
			}
			.related-post-card-desc {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.88rem;
				line-height: 1.35;
				overflow: hidden;
				display: -webkit-box;
				-webkit-box-orient: vertical;
				-webkit-line-clamp: 2;
			}
			.related-post-card-meta {
				display: flex;
				flex-wrap: wrap;
				gap: 0.45rem;
				align-items: center;
				color: rgb(var(--gray));
				font-size: 0.8rem;
			}
			.related-post-tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.35rem;
			}
			.related-post-tag {
				border: 1px solid rgb(var(--border));
				border-radius: 999px;
				padding: 0.12rem 0.45rem;
				background: rgba(var(--accent-rgb), 0.08);
				color: rgb(var(--gray-dark));
				font-size: 0.73rem;
				line-height: 1.2;
			}
			@media (max-width: 980px) {
				.related-posts-grid {
					grid-template-columns: 1fr;
				}
			}
			@media (max-width: 860px) {
				.post-header {
					grid-template-columns: 1fr;
					align-items: start;
				}
				.post-header-media {
					order: -1;
					max-width: 560px;
				}
				.post-header-main {
					justify-content: flex-start;
					gap: 0.75rem;
					padding-left: 5px;
				}
			}
			@media (max-width: 720px) {
				.post-main {
					padding-left: 0;
					padding-right: 0;
				}
				.post-content {
					border-left: 0;
					border-right: 0;
					border-radius: 0;
					padding: 1rem var(--page-gutter) 0.85rem;
				}

				.post-header-main {
					padding-left: 5px;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main class="post-main">
			<article class="post">
				<header class="post-header">
					<div class="post-header-main">
						<div class="post-meta">
							<span><FormattedDate date={pubDate} /></span>
							{typeof bodyCharCount === 'number' && (
								<span>{formatPostBodyCharCount(bodyCharCount)}</span>
							)}
							{lang && <span>{lang}</span>}
							{updatedDate && (
								<span>
									Updated <FormattedDate date={updatedDate} />
								</span>
							)}
						</div>
						<h1 class="post-title">{title}</h1>
						{tags.length > 0 && (
							<div class="post-tags">
								{tags.map((tag) => (
									<a class="badge" href={`/blog?tag=${encodeURIComponent(tag)}`}>
										{tag}
									</a>
								))}
							</div>
						)}
					</div>
					{heroImage && (
						<div class="post-header-media" aria-hidden="true">
							<img src={heroImage.src} width="720" height="450" alt="" loading="lazy" />
						</div>
					)}
				</header>
				<section class="post-content">
					<div class="prose">
						<slot />
					</div>
				</section>
				{relatedPosts.length > 0 && (
					<section class="related-posts" aria-label="Related posts">
						<h2 class="related-posts-title">Related Posts</h2>
						<div class="related-posts-grid">
							{relatedPosts.map((item) => (
								<a class="card card-hover related-post-card" href={`/blog/${item.id}/`}>
									<div class="related-post-card-meta">
										<span><FormattedDate date={item.data.pubDate} /></span>
										{item.data.lang && <span>{item.data.lang}</span>}
									</div>
									<h3 class="related-post-card-title">{item.data.title}</h3>
									<p class="related-post-card-desc">{item.listingDescription}</p>
									{(item.data.tags ?? []).length > 0 && (
										<div class="related-post-tags">
											{(item.data.tags ?? []).slice(0, 3).map((tag) => (
												<span class="related-post-tag">{tag}</span>
											))}
										</div>
									)}
								</a>
							))}
						</div>
					</section>
				)}
			</article>
		</main>
		<Footer />
	</body>
</html>
