---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	heroImage?: CollectionEntry<'blog'>['data']['heroImage'];
	tags?: string[];
	lang?: string;
	minutes?: number;
};

const { title, description, pubDate, updatedDate, heroImage, tags = [], lang, minutes } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			.post {
				max-width: 1120px;
				margin: 0 auto;
			}
			.post-hero {
				margin: 1.25rem 0 1rem;
			}
			.post-hero img {
				display: block;
				width: 100%;
				height: auto;
				border-radius: 16px;
				border: 1px solid rgb(var(--border));
				box-shadow: var(--shadow);
			}
			.post-header {
				padding: 0.25rem 0 1rem;
			}
			.post-title {
				margin: 0.5rem 0 0.75rem;
				letter-spacing: -0.02em;
			}
			.post-meta {
				display: flex;
				flex-wrap: wrap;
				gap: 0.6rem;
				align-items: center;
				color: rgb(var(--gray));
				font-size: 0.9rem;
			}
			.post-tags {
				margin-top: 0.75rem;
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
			}
			.post-content {
				border-radius: 16px;
				border: 1px solid rgb(var(--border));
				background: rgb(var(--prose-bg-rgb, var(--card)));
				padding: 1.35rem 1.35rem 1.1rem;
				box-shadow: none;
			}
			.prose {
				color: rgb(var(--gray-dark));
				font-size: var(--prose-font-size, 1.15rem);
				line-height: var(--prose-line-height, 1.95);
				font-family: var(--prose-font-family, var(--font-atkinson));
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article class="post">
				{heroImage && (
					<div class="post-hero">
						<img src={heroImage.src} width="1200" height="600" alt="" loading="lazy" />
					</div>
				)}
				<header class="post-header">
					<div class="post-meta">
						<span><FormattedDate date={pubDate} /></span>
						{typeof minutes === 'number' && <span>{minutes} min</span>}
						{lang && <span>{lang}</span>}
						{updatedDate && (
							<span>
								Updated <FormattedDate date={updatedDate} />
							</span>
						)}
					</div>
					<h1 class="post-title">{title}</h1>
					{tags.length > 0 && (
						<div class="post-tags">
							{tags.map((tag) => (
								<a class="badge" href={`/blog?tag=${encodeURIComponent(tag)}`}>
									{tag}
								</a>
							))}
						</div>
					)}
				</header>
				<section class="post-content">
					<div class="prose">
						<slot />
					</div>
				</section>
			</article>
		</main>
		<Footer />
	</body>
</html>
