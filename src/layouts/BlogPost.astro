---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	heroImage?: CollectionEntry<'blog'>['data']['heroImage'];
	tags?: string[];
	lang?: string;
	minutes?: number;
};

const { title, description, pubDate, updatedDate, heroImage, tags = [], lang, minutes } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			.post {
				max-width: 1120px;
				margin: 0 auto;
			}
			.post-header {
				display: grid;
				grid-template-columns: 1fr minmax(220px, 360px);
				gap: 1.25rem;
				align-items: stretch;
				padding: 0.25rem 0 1rem;
			}
			.post-header-main {
				margin: 30px 0;
				min-width: 0;
				display: flex;
				flex-direction: column;
				justify-content: space-between;
				align-self: stretch;
			}
			.post-header-media {
				width: 100%;
				border-radius: 16px;
				border: 1px solid rgb(var(--border));
				box-shadow: var(--shadow);
				overflow: hidden;
				aspect-ratio: 16 / 10;
				background: rgba(var(--card), var(--card-alpha, 0.84));
			}
			.post-header-media img {
				display: block;
				width: 100%;
				height: 100%;
				object-fit: cover;
			}
			.post-title {
				margin: 0;
				letter-spacing: -0.02em;
			}
			.post-meta {
				display: flex;
				flex-wrap: wrap;
				gap: 0.6rem;
				align-items: center;
				color: rgb(var(--gray));
				font-size: 0.9rem;
			}
			.post-tags {
				margin-top: 0;
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
			}
			.post-content {
				border-radius: 16px;
				border: 1px solid rgb(var(--border));
				background: rgb(var(--prose-bg-rgb, var(--card)));
				padding: 1.35rem 1.35rem 1.1rem;
				box-shadow: none;
			}
			.prose {
				color: rgb(var(--gray-dark));
				font-size: var(--prose-font-size, 1.15rem);
				line-height: var(--prose-line-height, 1.95);
				font-family: var(--prose-font-family, var(--font-atkinson));
			}
			@media (max-width: 860px) {
				.post-header {
					grid-template-columns: 1fr;
					align-items: start;
				}
				.post-header-media {
					order: -1;
					max-width: 560px;
				}
				.post-header-main {
					justify-content: flex-start;
					gap: 0.75rem;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article class="post">
				<header class="post-header">
					<div class="post-header-main">
						<div class="post-meta">
							<span><FormattedDate date={pubDate} /></span>
							{typeof minutes === 'number' && <span>{minutes} min</span>}
							{lang && <span>{lang}</span>}
							{updatedDate && (
								<span>
									Updated <FormattedDate date={updatedDate} />
								</span>
							)}
						</div>
						<h1 class="post-title">{title}</h1>
						{tags.length > 0 && (
							<div class="post-tags">
								{tags.map((tag) => (
									<a class="badge" href={`/blog?tag=${encodeURIComponent(tag)}`}>
										{tag}
									</a>
								))}
							</div>
						)}
					</div>
					{heroImage && (
						<div class="post-header-media" aria-hidden="true">
							<img src={heroImage.src} width="720" height="450" alt="" loading="lazy" />
						</div>
					)}
				</header>
				<section class="post-content">
					<div class="prose">
						<slot />
					</div>
				</section>
			</article>
		</main>
		<Footer />
	</body>
</html>
