---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Reading · ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<meta http-equiv="refresh" content="0; url=/reading" />
		<link rel="canonical" href="/reading" />
	</head>
	<body>
		<Header />
		<main>
			<div class="page-header">
				<div>
					<h1 class="page-title">Reading</h1>
					<p class="page-subtitle">Redirecting to the reading notebook.</p>
				</div>
			</div>
			<div class="card sidebar-card">
				<p style="margin: 0; color: rgb(var(--gray));"><a href="/reading">Open Reading</a></p>
			</div>
		</main>
		<Footer />
	</body>
</html>
