---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Links · ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<div class="page-header">
				<div>
					<h1 class="page-title">Links</h1>
					<p class="page-subtitle">Interesting website to get more</p>
				</div>
			</div>
			<div class="card sidebar-card">
				<ul style="margin: 0; padding-left: 1.25rem; color: rgb(var(--gray-dark));">
					<li><a href="https://www.hoshinogen.com/" target="GEN HOSHINO">GEN HOSHINO</a></li>
					<li><a href="https://harukimurakami.com/" target="HARUKI MURAKAMI">HARUKI MURAKAMI</a></li>
				</ul>
			</div>
		</main>
		<Footer />
	</body>
</html>
