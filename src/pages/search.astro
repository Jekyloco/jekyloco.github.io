---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { resolvePostDescription } from '../utils/postDescription';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const normalizeSearchText = (text?: string) => (text ?? '').replace(/\s+/g, ' ').trim();
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Search · ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<div class="page-header">
				<div>
					<a class="badge" href="/blog">Back to Posts</a>
					<h1 class="page-title">Search</h1>
					<p class="page-subtitle" id="search-subtitle">Type to search posts...</p>
				</div>
			</div>

			<div class="card sidebar-card" style="margin-bottom: 1rem;">
				<input
					id="search-input"
					class="sidebar-input"
					type="search"
					placeholder="Search by title / description / tag..."
					autocomplete="off"
				/>
			</div>

			<div class="post-list" id="search-results">
				{posts.map((post) => {
					const cardDescription = resolvePostDescription(
						post.data.description,
						post.body,
						post.data.title,
					);
					return (
						<a
							class="card card-hover post-card"
							href={`/blog/${post.id}/`}
							data-title={post.data.title}
							data-description={cardDescription}
							data-tags={(post.data.tags ?? []).join(',')}
							data-body={normalizeSearchText(post.body)}
						>
							<div class="post-card-main">
								<div class="post-card-meta">
									<span><FormattedDate date={post.data.pubDate} /></span>
									<span>{post.data.lang}</span>
								</div>
								<h2 class="post-card-title">{post.data.title}</h2>
								<p class="post-card-desc">{cardDescription}</p>
							</div>
						</a>
					);
				})}
			</div>
		</main>
		<Footer />

		<script is:inline data-astro-rerun>
			(() => {
				const tools = window.__pageStateTools;
				if (!tools) return;
				const page = tools.createCleanupContext('__searchPageCleanup');
				const { on } = page;

				const input = document.getElementById('search-input');
				const subtitle = document.getElementById('search-subtitle');
				const list = document.getElementById('search-results');
				if (!(input instanceof HTMLInputElement) || !subtitle || !list) return;

				const cards = Array.from(list.querySelectorAll('a[data-title]'));
				const params = new URLSearchParams(window.location.search);
				const initial = params.get('q') ?? '';
				input.value = initial;

				const apply = () => {
					const qRaw = input.value.trim();
					const q = qRaw.toLowerCase();
					let shown = 0;
					for (const el of cards) {
						const title = (el.getAttribute('data-title') ?? '').toLowerCase();
						const desc = (el.getAttribute('data-description') ?? '').toLowerCase();
						const tags = (el.getAttribute('data-tags') ?? '').toLowerCase();
						const body = (el.getAttribute('data-body') ?? '').toLowerCase();
						const ok = !q || title.includes(q) || desc.includes(q) || tags.includes(q) || body.includes(q);
						el.hidden = !ok;
						if (ok) shown += 1;
					}
					subtitle.textContent = qRaw ? `Showing ${shown} result(s) for "${qRaw}"` : 'Type to search posts...';
				};

				const syncUrl = () => {
					tools.updateQueryParams({ q: input.value.trim() }, { replace: true });
				};

				tools.bindComposingInput(page, input, () => {
					syncUrl();
					apply();
				});
				apply();
			})();
		</script>
	</body>
</html>
