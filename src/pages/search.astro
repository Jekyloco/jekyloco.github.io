---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const normalizeSearchText = (text?: string) => (text ?? '').replace(/\s+/g, ' ').trim();
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Search · ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<div class="page-header">
				<div>
					<a class="badge" href="/blog">Back</a>
					<h1 class="page-title">Search</h1>
					<p class="page-subtitle" id="search-subtitle">Type to search posts…</p>
				</div>
			</div>

			<div class="card sidebar-card" style="margin-bottom: 1rem;">
				<input
					id="search-input"
					class="sidebar-input"
					type="search"
					placeholder="Search by title / description / tag…"
					autocomplete="off"
				/>
			</div>

			<div class="post-list" id="search-results">
				{posts.map((post) => (
					<a
						class="card card-hover post-card"
						href={`/blog/${post.id}/`}
						data-title={post.data.title}
						data-description={post.data.description}
						data-tags={(post.data.tags ?? []).join(',')}
						data-body={normalizeSearchText(post.body)}
					>
						<div class="post-card-main">
							<div class="post-card-meta">
								<span><FormattedDate date={post.data.pubDate} /></span>
								<span>{post.data.lang}</span>
							</div>
							<h2 class="post-card-title">{post.data.title}</h2>
							<p class="post-card-desc">{post.data.description}</p>
						</div>
					</a>
				))}
			</div>
		</main>
		<Footer />

		<script is:inline>
			(() => {
				const input = document.getElementById('search-input');
				const subtitle = document.getElementById('search-subtitle');
				const list = document.getElementById('search-results');
				if (!(input instanceof HTMLInputElement) || !subtitle || !list) return;

				const cards = Array.from(list.querySelectorAll('a[data-title]'));
				const params = new URLSearchParams(window.location.search);
				const initial = params.get('q') ?? '';
				input.value = initial;

				const apply = () => {
					const qRaw = input.value.trim();
					const q = qRaw.toLowerCase();
					let shown = 0;
					for (const el of cards) {
						const title = (el.getAttribute('data-title') ?? '').toLowerCase();
						const desc = (el.getAttribute('data-description') ?? '').toLowerCase();
						const tags = (el.getAttribute('data-tags') ?? '').toLowerCase();
						const body = (el.getAttribute('data-body') ?? '').toLowerCase();
						const ok = !q || title.includes(q) || desc.includes(q) || tags.includes(q) || body.includes(q);
						el.hidden = !ok;
						if (ok) shown += 1;
					}
					subtitle.textContent = qRaw ? `Showing ${shown} result(s) for "${qRaw}"` : 'Type to search posts…';
				};

				const syncUrl = () => {
					const q = input.value.trim();
					const next = new URL(window.location.href);
					if (q) next.searchParams.set('q', q);
					else next.searchParams.delete('q');
					window.history.replaceState({}, '', next);
				};

				let composing = false;
				input.addEventListener('compositionstart', () => (composing = true));
				input.addEventListener('compositionend', () => {
					composing = false;
					syncUrl();
					apply();
				});
				input.addEventListener('input', () => {
					if (composing) return;
					syncUrl();
					apply();
				});
				apply();
			})();
		</script>
	</body>
</html>
